FROM node:20-alpine AS builder

WORKDIR /app

# Copy full repository
COPY . .

# Install dependencies
RUN npm ci

# Build frontend.
#
# Vite inlines `VITE_*` env vars at BUILD TIME, not runtime — they have to be
# present in this Docker build context, not just in the running container.
# Railway passes service env vars through to build args when the ARG is
# declared here with a matching name. Add a new VITE_ var? Add an ARG +
# matching ENV line below AND set the value in Railway's service variables.
#
# Variables consumed by the bundle:
#   VITE_API_BASE     — canonical API base URL ("/api" same-origin in prod)
#   VITE_POSTHOG_KEY  — PostHog project key (phc_...). When unset, the
#                       analytics shim silently no-ops.
#   VITE_POSTHOG_HOST — PostHog region host (us.i.posthog.com or
#                       eu.i.posthog.com). Mismatched region = lost events.
#   VITE_POSTHOG_KEY_ENV — BRAND_R0: environment the PostHog key was issued
#                       for (production | staging). A staging build carrying
#                       the production key is refused by src/lib/analyticsGuard.ts.
#   VITE_APP_ENV      — BRAND_R0: production | staging | preview. Drives the
#                       staging banner and the <meta name="bb-app-env"> tag.
#   VITE_GIT_SHA      — BRAND_R0: commit baked into <meta name="bb-git-sha">.
#                       Defaults to Railway's RAILWAY_GIT_COMMIT_SHA build arg.
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=$VITE_API_BASE
ARG VITE_POSTHOG_KEY
ENV VITE_POSTHOG_KEY=$VITE_POSTHOG_KEY
ARG VITE_POSTHOG_HOST
ENV VITE_POSTHOG_HOST=$VITE_POSTHOG_HOST
ARG VITE_POSTHOG_KEY_ENV
ENV VITE_POSTHOG_KEY_ENV=$VITE_POSTHOG_KEY_ENV
ARG VITE_APP_ENV
ENV VITE_APP_ENV=$VITE_APP_ENV
# Railway's own environment identity, forwarded automatically so the bundle
# never depends on a hand-copied VITE_APP_ENV alone (shared/deploy-env
# cross-checks the two; a disagreement is a configuration error).
ARG RAILWAY_ENVIRONMENT_NAME
ENV VITE_RAILWAY_ENVIRONMENT_NAME=$RAILWAY_ENVIRONMENT_NAME
ARG RAILWAY_GIT_COMMIT_SHA
ARG VITE_GIT_SHA=$RAILWAY_GIT_COMMIT_SHA
ENV VITE_GIT_SHA=$VITE_GIT_SHA
RUN npm run build

# Runner stage
FROM nginx:alpine

# BRAND_R0: non-production services set ROBOTS_TAG="noindex, nofollow" as a
# Railway service variable; docs/nginx.conf emits it as X-Robots-Tag. The empty
# default keeps production indexable (nginx omits an empty add_header value)
# and keeps the ${ROBOTS_TAG} template substitution defined.
ENV ROBOTS_TAG=""

# Copy custom nginx config
COPY docs/nginx.conf /etc/nginx/templates/default.conf.template

# Copy build artifacts
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
