{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2019"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["greatwork-engine/**/*", "progression/**/*"],
  "exclude": [
    "greatwork-engine/**/*.test.ts",
    "progression/**/*.test.ts",
    "greatwork-engine/**/__tests__/**"
  ]
}
