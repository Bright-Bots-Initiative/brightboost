{
  "description": "Required CI step invocations in .github/workflows/ci-cd.yml (W-11 / G-205). Covers all four jobs: build-only, build-and-test, db-check, e2e-flows (#782).",
  "workflow": ".github/workflows/ci-cd.yml",
  "requiredSteps": [
    { "job": "build-only", "run": "npm run build" },
    { "job": "build-and-test", "run": "npm run lint" },
    { "job": "build-and-test", "run": "npm run format:check" },
    { "job": "build-and-test", "run": "npm run typecheck" },
    { "job": "build-and-test", "run": "cd backend && npm run typecheck" },
    { "job": "build-and-test", "run": "bash scripts/check-prisma-drift.sh" },
    {
      "job": "build-and-test",
      "run": "bash scripts/verify-ci-step-presence.sh"
    },
    {
      "job": "build-and-test",
      "run": "node scripts/verify-type-program-membership.mjs"
    },
    { "job": "build-and-test", "run": "npm run agent:check" },
    { "job": "build-and-test", "run": "npm run docs:check" },
    { "job": "build-and-test", "run": "npm test -- --watch=false" },
    { "job": "build-and-test", "run": "npm run verify:storybook-empty-suite" },
    { "job": "build-and-test", "run": "npm run verify:ci-gate" },
    { "job": "build-and-test", "run": "npm run test:e2e:ci" },
    { "job": "build-and-test", "run": "npm run build" },
    { "job": "db-check", "run": "npx prisma migrate deploy" },
    { "job": "db-check", "run": "npx prisma generate" },
    { "job": "db-check", "run": "npm run test:db" },
    { "job": "e2e-flows", "run": "cd backend && npm run db:generate" },
    { "job": "e2e-flows", "run": "npx prisma generate" },
    { "job": "e2e-flows", "run": "npx prisma migrate deploy" },
    { "job": "e2e-flows", "run": "npm run e2e:seed | tee e2e-seed-out.txt" },
    {
      "job": "e2e-flows",
      "run": "nohup npm run start:dev > \"$GITHUB_WORKSPACE/backend.log\" 2>&1 &"
    },
    {
      "job": "e2e-flows",
      "run": "nohup npm run dev > \"$GITHUB_WORKSPACE/frontend.log\" 2>&1 &"
    },
    {
      "job": "e2e-flows",
      "run": "npx wait-on \"$CYPRESS_SWA_URL\" \"$BACKEND_ORIGIN/health\" --timeout 120000"
    },
    { "job": "e2e-flows", "run": "npm run test:e2e:ci:flows" }
  ]
}
