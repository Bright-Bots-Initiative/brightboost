FROM node:20-alpine

WORKDIR /app

# Copy full repository.
# LOAD-BEARING (#730 / G-010): `COPY . .` includes `shared/` at the image root.
# Narrowing this COPY (e.g. only backend/) would still let `tsc` and npm scripts
# succeed if misconfigured, but the shared engine would be missing at runtime /
# shared compile time and the container would fail at start. Do not narrow
# without re-proving W-04 (container start + /health).
COPY . .

# Install root dependencies
RUN npm ci

# Install backend dependencies
WORKDIR /app/backend
RUN npm ci

# Generate Prisma Client (root schema)
WORKDIR /app
RUN npx prisma generate

# Build backend
# Using explicit prefix command as requested to run from root context if needed, or consistent with instruction
# "Build backend using npm --prefix backend run build:railway"
RUN npm --prefix backend run build:railway

# Expose port
EXPOSE 3000

# Start server
CMD ["npm", "--prefix", "backend", "run", "start"]
